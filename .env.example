# Set ONE of these. Gemini is used when both are present (override with EXTRACT_PROVIDER).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# EXTRACT_PROVIDER=gemini        # or anthropic
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash   # tried in order; each has its own daily quota
# ANTHROPIC_MODEL=claude-sonnet-5-5
# VERIFY_MODEL=gemini-3.1-pro-preview   # a DIFFERENT model re-reads bill/container numbers; off when unset
# EXTRACT_PASSCODE=                       # require this code for /api/extract; the sample stays open
